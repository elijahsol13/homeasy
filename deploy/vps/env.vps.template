# Homeasy VPS — operator template. NEVER commit your populated .env.
# Copy to repository root as .env, replace every CHANGE_ME, then chmod 600 .env.
# Transfer only the settings listed here from the Mac; never copy the full .env.
# Compose sets NODE_ENV, DATABASE_PATH, HOMEASY_DEPLOYMENT_ROLE, API_PORT/HOST,
# LISTING_READ_PATH, CANONICAL_READ_CANARY_TELEGRAM_IDS and CANONICAL_ALERTS_ENABLED.
BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
ADMIN_IDS=CHANGE_ME_NUMERIC_TELEGRAM_ADMIN_IDS
BOT_DELIVERY_MODE=polling
ADMIN_REVIEW_ALERTS_ENABLED=CHANGE_ME_COPY_FROM_MAC
LOG_LEVEL=CHANGE_ME_COPY_FROM_MAC

# Preserve every configured AI provider so the existing fallback order remains available.
GROQ_API_KEY=CHANGE_ME_COPY_FROM_MAC
GEMINI_API_KEY=CHANGE_ME_COPY_FROM_MAC
CLOUDFLARE_API_KEY=CHANGE_ME_COPY_FROM_MAC
# If the Mac uses CLOUDFLARE_ACC_ID, put its value under this canonical name.
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME_COPY_FROM_MAC

# Backend analytics and public/tracking links; copy exact current Mac values.
POSTHOG_API_KEY=CHANGE_ME_COPY_FROM_MAC
POSTHOG_HOST=CHANGE_ME_COPY_FROM_MAC
API_PUBLIC_URL=CHANGE_ME_COPY_FROM_MAC
TRACKING_PUBLIC_URL=CHANGE_ME_COPY_FROM_MAC
WEBAPP_URL=CHANGE_ME_COPY_FROM_MAC
TELEGRAM_MINIAPP_URL=CHANGE_ME_COPY_FROM_MAC

# Optional: needed only for separately approved, manual Bright Data scripts.
# If set here, Compose passes it into api, bot and scraper via env_file.
BRIGHTDATA_API_KEY=

# Same random 64-hex token on VPS and Mac; FB_INGEST_URL belongs on Mac only.
FB_INGEST_TOKEN=CHANGE_ME_SAME_64_HEX_CHARACTERS_AS_MAC
# Do not set FB_INGEST_URL on the VPS.
# VITE_POSTHOG_API_KEY and VITE_POSTHOG_HOST belong in Cloudflare Pages build
# settings for the Mini App, not in this VPS .env.
# Do not copy FB_PROXY: it is not read by current runtime and proxy egress is not used.
