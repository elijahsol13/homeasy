# Homeasy VPS — operator template. NEVER commit your populated .env.
# Copy to repository root as .env, replace every CHANGE_ME, then chmod 600 .env.
# Match approved production settings from the existing Mac .env selectively.
# The actual DATABASE_PATH and HOMEASY_DEPLOYMENT_ROLE are set by docker-compose.yml.
BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
ADMIN_IDS=CHANGE_ME_NUMERIC_TELEGRAM_ADMIN_IDS
GEMINI_API_KEY=CHANGE_ME_IF_EXTRACTION_USES_GEMINI
BOT_DELIVERY_MODE=polling
# Copy the actual existing Telegram deep link (https://t.me/...) from the Mac.
# A Cloudflare Pages website URL is NOT valid for tracking deep links.
TELEGRAM_MINIAPP_URL=https://t.me/CHANGE_ME_EXISTING_MINI_APP_LINK
# Preserve CANONICAL_LISTING_EXTRACTION and other extraction flags from the
# currently running installation; do not silently change extraction behavior.
FB_INGEST_TOKEN=CHANGE_ME_SAME_64_HEX_CHARACTERS_AS_MAC
# FB_INGEST_URL is intentionally absent: ONLY set it on the Mac.
# Optional configured provider keys, group discovery options and admin settings
# must be brought over explicitly from existing production configuration.
